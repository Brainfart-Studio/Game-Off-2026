[node name="Run" type="Node2D"]
script = ExtResource("6_run")
config = ExtResource("7_cfg")

[node name="Arena" parent="." instance=ExtResource("1_arena")]

[node name="Player" parent="." instance=ExtResource("2_player")]

[node name="GameCamera" parent="." instance=ExtResource("4_camera")]

[node name="WorldShift" parent="." instance=ExtResource("5_shift")]

[node name="Results" parent="." instance=ExtResource("12_results")]

[node name="DebugOverlay" parent="." instance=ExtResource("3_overlay")]

[node name="StateMachine" type="Node" parent="."]
script = ExtResource("8_machine")

[node name="Starting" type="Node" parent="StateMachine"]
script = ExtResource("9_starting")

[node name="Running" type="Node" parent="StateMachine"]
script = ExtResource("10_running")

[node name="Ended" type="Node" parent="StateMachine"]
script = ExtResource("11_ended")
