[gd_resource type="Resource" script_class="SpawnConfig" format=3]

[ext_resource type="Script" path="res://scripts/systems/enemies/spawn_config.gd" id="1_cfg"]
[ext_resource type="Script" path="res://scripts/core/animation_def.gd" id="2_def"]
[ext_resource type="Resource" path="res://config/enemies/walker.tres" id="3_walker"]
[ext_resource type="Script" path="res://scripts/systems/enemies/enemy_data.gd" id="4_data"]

[sub_resource type="Resource" id="Resource_telegraph"]
script = ExtResource("2_def")
id = &"fx_spawn_telegraph"
path = "res://art/fx/fx_spawn_telegraph.png"
frame_size = Vector2i(32, 32)
frames = 6
fps = 12.0
loop = true

[resource]
script = ExtResource("1_cfg")
enemies = Array[ExtResource("4_data")]([ExtResource("3_walker")])
telegraph_animation = SubResource("Resource_telegraph")
