[gd_resource type="Resource" script_class="FeedbackConfig" format=3]

[ext_resource type="Script" path="res://scripts/systems/feedback/feedback_config.gd" id="1_cfg"]
[ext_resource type="Script" path="res://scripts/systems/feedback/feedback_entry.gd" id="2_entry"]
[ext_resource type="Script" path="res://scripts/systems/feedback/effects/shake_effect.gd" id="3_shake"]
[ext_resource type="Script" path="res://scripts/systems/feedback/effects/haptics_effect.gd" id="4_haptics"]
[ext_resource type="Script" path="res://scripts/systems/feedback/feedback_effect.gd" id="5_effect"]
[ext_resource type="Script" path="res://scripts/systems/feedback/effects/hitstop_effect.gd" id="6_hitstop"]
[ext_resource type="Script" path="res://scripts/systems/feedback/effects/screen_flash_effect.gd" id="7_screen_flash"]
[ext_resource type="Script" path="res://scripts/systems/feedback/effects/sprite_flash_effect.gd" id="8_sprite_flash"]

[ext_resource type="Script" path="res://scripts/systems/feedback/effects/spawn_fx_effect.gd" id="9_spawn_fx"]
[ext_resource type="Script" path="res://scripts/core/animation_def.gd" id="10_def"]

[sub_resource type="Resource" id="Resource_shift_shake"]
script = ExtResource("3_shake")
trauma = 0.12

[sub_resource type="Resource" id="Resource_shift_haptics"]
script = ExtResource("4_haptics")
weak = 0.25
strong = 0.0
duration = 0.08

[sub_resource type="Resource" id="Resource_shift"]
script = ExtResource("2_entry")
id = &"shift"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_shift_shake"), SubResource("Resource_shift_haptics")])

[sub_resource type="Resource" id="Resource_denied_haptics"]
script = ExtResource("4_haptics")
weak = 0.15
strong = 0.0
duration = 0.05

[sub_resource type="Resource" id="Resource_shift_denied"]
script = ExtResource("2_entry")
id = &"shift_denied"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_denied_haptics")])

[sub_resource type="Resource" id="Resource_hurt_shake"]
script = ExtResource("3_shake")
trauma = 0.5

[sub_resource type="Resource" id="Resource_hurt_hitstop"]
script = ExtResource("6_hitstop")
duration = 0.08
time_scale = 0.05

[sub_resource type="Resource" id="Resource_hurt_screen_flash"]
script = ExtResource("7_screen_flash")
color = Color(1, 0.2, 0.2, 0.35)
duration = 0.15

[sub_resource type="Resource" id="Resource_hurt_sprite_flash"]
script = ExtResource("8_sprite_flash")
color = Color(1, 0.3, 0.3, 1)
duration = 0.15

[sub_resource type="Resource" id="Resource_hurt_haptics"]
script = ExtResource("4_haptics")
weak = 0.6
strong = 0.8
duration = 0.25

[sub_resource type="Resource" id="Resource_player_hurt"]
script = ExtResource("2_entry")
id = &"player_hurt"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_hurt_shake"), SubResource("Resource_hurt_hitstop"), SubResource("Resource_hurt_screen_flash"), SubResource("Resource_hurt_sprite_flash"), SubResource("Resource_hurt_haptics")])

[sub_resource type="Resource" id="Resource_death_shake"]
script = ExtResource("3_shake")
trauma = 0.8

[sub_resource type="Resource" id="Resource_death_screen_flash"]
script = ExtResource("7_screen_flash")
color = Color(1, 1, 1, 0.5)
duration = 0.3

[sub_resource type="Resource" id="Resource_death_haptics"]
script = ExtResource("4_haptics")
weak = 1.0
strong = 1.0
duration = 0.5

[sub_resource type="Resource" id="Resource_player_death"]
script = ExtResource("2_entry")
id = &"player_death"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_death_shake"), SubResource("Resource_death_screen_flash"), SubResource("Resource_death_haptics")])

[sub_resource type="Resource" id="Resource_hit_spark"]
script = ExtResource("10_def")
id = &"fx_hit_spark"
path = "res://art/fx/fx_hit_spark.png"
frame_size = Vector2i(32, 32)
frames = 4
fps = 24.0
loop = false

[sub_resource type="Resource" id="Resource_hit_light_hitstop"]
script = ExtResource("6_hitstop")
duration = 0.06
time_scale = 0.05

[sub_resource type="Resource" id="Resource_hit_light_shake"]
script = ExtResource("3_shake")
trauma = 0.2

[sub_resource type="Resource" id="Resource_hit_light_flash"]
script = ExtResource("8_sprite_flash")
color = Color(1, 1, 1, 1)
duration = 0.08

[sub_resource type="Resource" id="Resource_hit_light_spark"]
script = ExtResource("9_spawn_fx")
animation = SubResource("Resource_hit_spark")

[sub_resource type="Resource" id="Resource_hit_light_haptics"]
script = ExtResource("4_haptics")
weak = 0.25
strong = 0.0
duration = 0.06

[sub_resource type="Resource" id="Resource_hit_light"]
script = ExtResource("2_entry")
id = &"hit_light"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_hit_light_hitstop"), SubResource("Resource_hit_light_shake"), SubResource("Resource_hit_light_flash"), SubResource("Resource_hit_light_spark"), SubResource("Resource_hit_light_haptics")])

[sub_resource type="Resource" id="Resource_death_burst"]
script = ExtResource("10_def")
id = &"fx_death_burst"
path = "res://art/fx/fx_death_burst.png"
frame_size = Vector2i(32, 32)
frames = 6
fps = 20.0
loop = false

[sub_resource type="Resource" id="Resource_enemy_death_shake"]
script = ExtResource("3_shake")
trauma = 0.3

[sub_resource type="Resource" id="Resource_enemy_death_burst"]
script = ExtResource("9_spawn_fx")
animation = SubResource("Resource_death_burst")
offset = Vector2(0, -12)

[sub_resource type="Resource" id="Resource_enemy_death"]
script = ExtResource("2_entry")
id = &"enemy_death"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_enemy_death_shake"), SubResource("Resource_enemy_death_burst")])

[sub_resource type="Resource" id="Resource_combo_up_shake"]
script = ExtResource("3_shake")
trauma = 0.1

[sub_resource type="Resource" id="Resource_combo_up_flash"]
script = ExtResource("7_screen_flash")
color = Color(1, 0.9, 0.4, 0.15)
duration = 0.08

[sub_resource type="Resource" id="Resource_combo_up"]
script = ExtResource("2_entry")
id = &"combo_up"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_combo_up_shake"), SubResource("Resource_combo_up_flash")])

[resource]
script = ExtResource("1_cfg")
entries = Array[ExtResource("2_entry")]([SubResource("Resource_shift"), SubResource("Resource_shift_denied"), SubResource("Resource_player_hurt"), SubResource("Resource_player_death"), SubResource("Resource_hit_light"), SubResource("Resource_enemy_death"), SubResource("Resource_combo_up")])
bindings = Dictionary[StringName, StringName]({
&"combo_raised": &"combo_up",
&"enemy_killed": &"enemy_death",
&"hit_landed": &"hit_light",
&"player_damaged": &"player_hurt",
&"player_died": &"player_death",
&"shift_denied": &"shift_denied",
&"world_shift_started": &"shift"
})
