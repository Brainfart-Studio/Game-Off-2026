[gd_resource type="Resource" script_class="FeedbackConfig" format=3]

[ext_resource type="Script" path="res://scripts/systems/feedback/feedback_config.gd" id="1_cfg"]
[ext_resource type="Script" path="res://scripts/systems/feedback/feedback_entry.gd" id="2_entry"]
[ext_resource type="Script" path="res://scripts/systems/feedback/effects/shake_effect.gd" id="3_shake"]
[ext_resource type="Script" path="res://scripts/systems/feedback/effects/haptics_effect.gd" id="4_haptics"]
[ext_resource type="Script" path="res://scripts/systems/feedback/feedback_effect.gd" id="5_effect"]

[sub_resource type="Resource" id="Resource_shift_shake"]
script = ExtResource("3_shake")
trauma = 0.12

[sub_resource type="Resource" id="Resource_shift_haptics"]
script = ExtResource("4_haptics")
weak = 0.25
strong = 0.0
duration = 0.08

[sub_resource type="Resource" id="Resource_shift"]
script = ExtResource("2_entry")
id = &"shift"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_shift_shake"), SubResource("Resource_shift_haptics")])

[sub_resource type="Resource" id="Resource_denied_haptics"]
script = ExtResource("4_haptics")
weak = 0.15
strong = 0.0
duration = 0.05

[sub_resource type="Resource" id="Resource_shift_denied"]
script = ExtResource("2_entry")
id = &"shift_denied"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_denied_haptics")])

[resource]
script = ExtResource("1_cfg")
entries = Array[ExtResource("2_entry")]([SubResource("Resource_shift"), SubResource("Resource_shift_denied")])
bindings = Dictionary[StringName, StringName]({
&"shift_denied": &"shift_denied",
&"world_shift_started": &"shift"
})
